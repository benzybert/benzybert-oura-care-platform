# Copy to .env.local for local work. On Vercel, set these in Project Settings -> Environment Variables.
# Never commit real values.

# --- Database (any Postgres: Neon / Supabase via the Vercel Marketplace, or RDS) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Oura OAuth2 app (https://developer.ouraring.com -> create an application) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match a redirect URI registered in the Oura app, e.g.
# https://<your-dev-preview-domain>/api/oura/callback
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# --- Secrets (generate each with: openssl rand -base64 32) ---
# 32-byte key, base64. Encrypts Oura tokens at rest (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=
# Signs session cookies.
SESSION_SECRET=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Mail ---
# Mail settings live in src/config/mail.ts. RESEND_API_KEY / MAIL_FROM here are optional overrides.
RESEND_API_KEY=
MAIL_FROM=

# --- Privacy settings ---
# Org dashboards show nothing for a group smaller than this.
ORG_MIN_COHORT=5

# --- Demo mode (preview/dev only; MUST be false or unset in a real deployment) ---
DEMO_AUTH=false
